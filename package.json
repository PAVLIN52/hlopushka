{
  "name": "hlopushka",
  "private": true,
  "description": "Хлопушка — канбан-трекер задач для видеопродакшна",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:shared": "npm run build -w shared",
    "dev": "npm run build:shared && npm run dev --workspaces --if-present",
    "build": "npm run build:shared && npm run build -w backend && npm run build -w frontend",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
