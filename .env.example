# ---------------------------------------------------------------
# Хлопушка — переменные окружения (скопируйте в .env)
# Секретов здесь нет: значения ниже — только для локальной разработки.
# ---------------------------------------------------------------

# Подключение к PostgreSQL (в docker compose хост — postgres)
POSTGRES_USER=hlopushka
POSTGRES_PASSWORD=hlopushka
POSTGRES_DB=hlopushka
DATABASE_URL=postgresql://hlopushka:hlopushka@localhost:5432/hlopushka?schema=public

# Секреты подписи JWT (обязательно поменяйте вне локальной разработки, минимум 32 символа)
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef

# Порт бэкенда и адрес фронтенда (для CORS и cookie)
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Адреса бэкенда, которые видит браузер
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=http://localhost:4000
